---
import Base from './Base.astro';
import { sectionFor, sitePath, isExternal } from '~/data/nav';

interface Props {
  title: string;
  description?: string;
  /** Wider content column, for tables and grids. */
  full?: boolean;
  /** Show the description under the title (it is always used as meta description). */
  lede?: boolean;
}

const { title, description, full = false, lede = true } = Astro.props;
const path = sitePath(Astro.url.pathname);
const section = sectionFor(path);
const isCurrent = (href: string) => href === path || href === path + '/';
const atHub = section && isCurrent(section.href);
---

<Base title={title} description={description}>
  <div class="page-head">
    <div class="wrap">
      {
        section && !atHub && (
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/">Home</a><span aria-hidden="true">/</span><a href={section.href}>{section.label}</a>
          </nav>
        )
      }
      <slot name="kicker" />
      <h1>{title}</h1>
      {lede && description && <p class="lede">{description}</p>}
      <slot name="head" />
    </div>
  </div>
  <div class:list={["wrap page-grid", { "no-subnav": !section }]}>
    {
      section && (
        <aside class="subnav">
          <nav aria-label={`${section.label} pages`}>
            <p class="subnav-title">{section.label}</p>
            <ul>
              {section.children.map((c) => (
                <>
                  {c.group && <li class="subnav-group" aria-hidden="true">{c.group}</li>}
                  <li>
                    <a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>
                      {c.label}{isExternal(c.href) && ' ↗'}
                    </a>
                  </li>
                </>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
    <article class:list={['prose', { full }]}>
      <slot />
    </article>
  </div>
  <slot name="after-main" slot="after-main" />
</Base>

<script>
  // On phones the sub-navigation is a row of chips; make sure the current one is visible.
  const current = document.querySelector<HTMLElement>('.subnav a[aria-current]');
  const row = current?.closest('ul');
  if (current && row && row.scrollWidth > row.clientWidth) row.scrollLeft = current.offsetLeft - 16;
</script>
