---
// Photo grid for a folder under src/assets/galleries/. Thumbnails and the
// enlarged view are resized at build time; click opens a lightbox.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Folder name, e.g. "honorary-members-2024" (a legacy "/assets/img/…" path also works). */
  folder: string;
}

const name = Astro.props.folder.split('/').filter(Boolean).pop();
const all = import.meta.glob<{ default: ImageMetadata }>('/src/assets/galleries/**/*.{jpg,jpeg,png,JPG,JPEG,PNG}', { eager: true });
const photos = await Promise.all(
  Object.entries(all)
    .filter(([p]) => p.split('/').at(-2) === name)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(async ([p, mod]) => ({
      src: mod.default,
      large: (await getImage({ src: mod.default, width: 1600 })).src,
      alt: p.split('/').pop()!.replace(/\.\w+$/, '').replace(/[-_]+/g, ' '),
    })),
);
---

<div class="gallery" data-gallery>
  {
    photos.map((ph) => (
      <a href={ph.large} data-large={ph.large}>
        <Image src={ph.src} alt={ph.alt} width={480} loading="lazy" decoding="async" />
      </a>
    ))
  }
</div>

<script>
  let dialog: HTMLDialogElement | null = null;
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('[data-gallery] a');
    if (!a) return;
    e.preventDefault();
    if (!dialog) {
      dialog = document.createElement('dialog');
      dialog.className = 'lightbox';
      dialog.innerHTML = '<button type="button" aria-label="Close">×</button><img alt="">';
      dialog.addEventListener('click', () => dialog!.close());
      document.body.append(dialog);
    }
    const img = dialog.querySelector('img')!;
    img.src = a.dataset.large!;
    img.alt = a.querySelector('img')?.alt ?? '';
    dialog.showModal();
  });
</script>
