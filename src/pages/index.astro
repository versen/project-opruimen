---
import Base from '~/layouts/Base.astro';
import NewsCard from '~/components/NewsCard.astro';
import Follow from '~/components/Follow.astro';
import { allNews } from '~/lib/news';
import { stats, spotlights, mission, tasks } from '~/data/home';
import { upcomingEvents, formatEventDate } from '~/lib/events';
import { groups, membersOf } from '~/lib/groups';
import { isExternal } from '~/data/nav';

const news = await allNews();
const latest = news.slice(0, 3);
const next = (await upcomingEvents())[0];
const shown = spotlights.filter((s) => s.show).slice(0, 2);
const activeGroups = await groups();
const volunteers = new Set(activeGroups.flatMap((g) => membersOf(g).map((m) => m.name))).size;
const taskText = (t: (typeof tasks)[number]) =>
  t.href === '/working-groups/' ? `${volunteers} people in ${activeGroups.length} groups do the work behind VERSEN. Any member can take part.` : t.text;
---

<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="kicker">VEReniging Software Engineering Nederland</span>
        <h1>The Dutch community for <em>software engineering</em></h1>
        <p class="lede">Researchers, educators and practitioners, working together through working groups, events and awards.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/join/">Join VERSEN — free</a>
          <a class="btn btn-ghost" href="/resources/sria/">Read our research agenda</a>
        </div>
        <ul class="stats">
          {stats.map((s) => <li><strong>{s.value}</strong><span>{s.label}</span></li>)}
        </ul>
      </div>
      <div class="hero-art" aria-hidden="true">
        <img src="/assets/img/cover-image.svg" alt="" width="560" height="420" />
      </div>
    </div>
  </section>

  {
    (next || shown.length > 0) && (
      <section class="wrap" aria-labelledby="spot-h">
        <div class="notices">
          <h2 id="spot-h" class="notices-label">Right now</h2>
          <ul>
            {next && (
              <li>
                <a href={next.href}>
                  <span class="tag versen">Upcoming</span>
                  <span class="notice-title">{next.title}{next.date && <span class="muted"> · {formatEventDate(next.date)}</span>}</span>
                </a>
              </li>
            )}
            {shown.map((s) => (
              <li>
                <a href={s.href}>
                  <span class="tag">{s.kicker}</span>
                  <span class="notice-title">{s.title}{isExternal(s.href) && ' ↗'}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section wrap" aria-labelledby="mission-h">
    <div class="section-head">
      <h2 id="mission-h">Our mission</h2>
      <a href="/about/" class="arrow">About VERSEN </a>
    </div>
    <div class="mission">
      <p>{mission.lead}</p>
      <ul>
        {mission.goals.map((g) => <li>{g}</li>)}
      </ul>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="news-h">
    <div class="section-head">
      <h2 id="news-h">Latest news</h2>
      <a href="/news/" class="arrow">All news </a>
    </div>
    <ul class="news-list even">
      {latest.map((item) => <NewsCard item={item} />)}
    </ul>
    <Follow />
  </section>

  <section class="section wrap" aria-labelledby="do-h">
    <div class="section-head">
      <h2 id="do-h">Take part</h2>
      <a href="/working-groups/" class="arrow">All working groups </a>
    </div>
    <ul class="tasks">
      {
        tasks.map((t) => (
          <li>
            <h3><a href={t.href}>{t.title}{isExternal(t.href) && <span class="ext-mark"> ↗</span>}</a></h3>
            <p>{taskText(t)}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="join-band" slot="after-main">
    <div class="wrap">
      <div>
        <h2>Work on software engineering in the Netherlands?</h2>
        <p>Membership is free and brings you the VERSEN newsletter and invitations to our events.</p>
      </div>
      <a class="btn" href="/join/">Become a member</a>
    </div>
  </section>
</Base>
